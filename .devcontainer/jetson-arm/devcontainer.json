{
    "name": "Wheelchair2 Development on Jetson",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "privileged": true,
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/container_user/wheelchair2/src,type=bind",
    "workspaceFolder": "/home/container_user/wheelchair2/src",
    "customizations": {
        "vscode": {
            "settings": {
                "actionButtons": {
                    "defaultColor": "#ff0034",
                    "loadNpmCommands": false,
                    "reloadButton": "♻️",   
                    "commands": [
                        {
                            "name": "Build WS",
                            "cwd": "/home/container_user/wheelchair2",
                            "color": "aqua",
                            "singleInstance": true,
                            "command": "colcon build --symlink-install --packages-ignore rosbridge_server rosapi rosbridge_library laser_filters --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && source install/setup.bash"
                        }
                    ]
                },
                "C_Cpp.default.intelliSenseMode": "gcc-x64",
                "files.autoSave": "onFocusChange"
            },
            "extensions": [
                "althack.ament-task-provider",
                "DotJoshJohnson.xml",
                "ms-azuretools.vscode-docker",
                "Ranch-Hand-Robotics.rde-pack",
                "ms-python.python",
                "ms-vscode.cpptools",
                "redhat.vscode-yaml",
                "seunlanlege.action-buttons",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": ":1001",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "PULSE_SERVER": "${localEnv:PULSE_SERVER}",
        "QT_X11_NO_MITSHM": "1",
        "ROS_DOMAIN_ID": "19" // Adding this will restrict your ROS 2 nodes to communicate only with systems in the network with same ROS_DOMAIN_ID, preventing interference from other ROS 2 nodes on the same network.
        // "LIBGL_ALWAYS_SOFTWARE": "1"
    },
    "runArgs": [
        "--runtime=nvidia",
        "--cap-add=SYS_NICE",
        "--ulimit=rtprio=99",
        "--ulimit=rttime=-1",
        "--ulimit=memlock=8428281856",
        "--cap-add=all",
        "--security-opt=seccomp:unconfined",
        "--security-opt=apparmor:unconfined",
        // "--device=/dev/ttyACM0", // Motor driver only
        "--volume=/dev:/dev", // Realsense and Motor driver
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
        "--net=host",
        "--ipc=host"
    ]
    ,
    "postStartCommand": "sudo chown -R container_user:container_user /home/container_user/wheelchair2 /run",
    "postCreateCommand": "bash /home/container_user/wheelchair2/src/scripts/post_create.sh",
    "initializeCommand": "xhost +local:root"
}
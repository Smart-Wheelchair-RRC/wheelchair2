<?xml version="1.0" encoding="UTF-8"?>
<robot name="wheelchair2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find wheelchair2_description)/urdf/kangaroo_ros2_control.urdf.xacro" />
    <xacro:include filename="$(find wheelchair2_description)/urdf/realsense_base.urdf.xacro" />
    <xacro:include filename="$(find wheelchair2_description)/urdf/tof_sensor.urdf.xacro" />
    <xacro:include filename="$(find wheelchair2_description)/urdf/ultrasonic_sensor.urdf.xacro" />

    <link name="base_footprint" />

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.16" rpy="0 0 0" /> 
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0.215 0 0.2" rpy="0 0 0"/>
            <geometry>
                <box size="1.13 0.66 0.5"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.8 0.5"/>
            </material>
        </visual>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry><cylinder radius="0.16" length="0.05"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
    </link>
    <joint name="base_link_to_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.2775 0" rpy="-1.570796 0 0"/> 
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry><cylinder radius="0.16" length="0.05"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
    </link>
    <joint name="base_link_to_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.2775 0" rpy="-1.570796 0 0"/> 
        <axis xyz="0 0 1"/>
    </joint>

    <link name="caster_left">
        <visual>
            <geometry><sphere radius="0.1"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
    </link>
    <joint name="caster_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_left"/>
        <origin xyz="0.49 0.2775 -0.06" rpy="0 0 0"/>
    </joint>

    <link name="caster_right">
        <visual>
            <geometry><sphere radius="0.1"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
    </link>
    <joint name="caster_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_right"/>
        <origin xyz="0.49 -0.2775 -0.06" rpy="0 0 0"/>
    </joint>

    <link name="livox_frame"/>
    <joint name="base_to_livox" type="fixed">
        <parent link="base_link" />
        <child link="livox_frame" />
        <origin xyz="0 0 1.44" rpy="0 0 0" />
    </joint>

    <link name="camera_mount_link"/>
    <joint name="camera_mount" type="fixed">
        <parent link="livox_frame" />
        <child link="camera_mount_link" />
        <origin xyz="0.08 0.0 0.05" rpy="0.0 0.52 0.0" />
        <axis xyz="0 0 0" /> 
    </joint>
    <xacro:realsense name="camera1" topics_ns="camera1" parent="camera_mount_link" use_sim_time="$(arg use_sim_time)">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:realsense>

    <xacro:tof_sensor name="tof_front_right" parent="base_link" xyz="0.50 -0.275 0.14" rpy="0 0 0" index="2" />

    <xacro:tof_sensor name="tof_front_right_side" parent="base_link" xyz="0.465 -0.305 0.16" rpy="0 0 -1.570796" index="3" />

    <xacro:tof_sensor name="tof_side_right" parent="base_link" xyz="0.205 -0.24 0.065" rpy="0 0 -1.570796" index="4" />

    <xacro:tof_sensor name="tof_front_left" parent="base_link" xyz="0.50 0.275 0.14" rpy="0 0 0" index="1" />

    <xacro:tof_sensor name="tof_front_left_side" parent="base_link" xyz="0.465 0.305 0.16" rpy="0 0 1.5708" index="0" />

    <xacro:tof_sensor name="tof_side_left" parent="base_link" xyz="0.205 0.24 0.065" rpy="0 0 1.570796" index="6" />

    <xacro:tof_sensor name="tof_back_middle" parent="base_link" xyz="-0.245 -0.03 0.40" rpy="0 0 3.141592" index="7" />

    <xacro:tof_sensor name="tof_back_down" parent="base_link" xyz="-0.245 0.0 -0.01" rpy="0 0 3.141592" index="5" />


    <xacro:ultrasonic_sensor name="us_side_right" parent="base_link" xyz="0.22 -0.23 0.05" rpy="0 0 -1.570796" />

    <xacro:ultrasonic_sensor name="us_side_left" parent="base_link" xyz="0.22 0.23 0.055" rpy="0 0 1.570796" />

    <xacro:ultrasonic_sensor name="us_back_middle" parent="base_link" xyz="-0.245 0.0 0.37" rpy="0 0 3.141592" />

    <xacro:ultrasonic_sensor name="us_up_right" parent="base_link" xyz="0.08 -0.09 1.52" rpy="0 0 -0.7854" />

    <xacro:ultrasonic_sensor name="us_up_middle" parent="base_link" xyz="0.13 0.0 1.555" rpy="0 0 0" />

    <xacro:ultrasonic_sensor name="us_up_left" parent="base_link" xyz="0.08 0.09 1.52" rpy="0 0 0.7854" />


    <xacro:kangaroo_x2_driver name="kangaroo_ros2_control" prefix="" use_sim_time="false"/>

</robot>
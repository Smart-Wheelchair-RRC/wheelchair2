<?xml version="1.0" encoding="UTF-8"?>
<robot name="wheelchair2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find wheelchair2_description)/urdf/kangaroo_ros2_control.urdf.xacro" />
    <xacro:include filename="$(find wheelchair2_description)/urdf/tof_sensor.urdf.xacro" />

    <link name="base_footprint" />

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.16" rpy="0 0 0" /> 
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0.215 0 0.2" rpy="0 0 0"/>
            <geometry>
                <box size="1.13 0.66 0.5"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.8 0.5"/>
            </material>
        </visual>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry><cylinder radius="0.16" length="0.05"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
    </link>
    <joint name="base_link_to_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.2775 0" rpy="-1.570796 0 0"/> 
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry><cylinder radius="0.16" length="0.05"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
    </link>
    <joint name="base_link_to_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.2775 0" rpy="-1.570796 0 0"/> 
        <axis xyz="0 0 1"/>
    </joint>

    <link name="caster_left">
        <visual>
            <geometry><sphere radius="0.1"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
    </link>
    <joint name="caster_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_left"/>
        <origin xyz="0.49 0.2775 -0.06" rpy="0 0 0"/>
    </joint>

    <link name="caster_right">
        <visual>
            <geometry><sphere radius="0.1"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
    </link>
    <joint name="caster_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_right"/>
        <origin xyz="0.49 -0.2775 -0.06" rpy="0 0 0"/>
    </joint>

    <link name="laser"/>
    <joint name="base_to_laser" type="fixed">
        <parent link="base_link" />
        <child link="laser" />
        <origin xyz="0.21 0.0057 -0.068" rpy="0 3.14 0" />
    </joint>

    <link name="livox_frame"/>
    <joint name="base_to_livox" type="fixed">
        <parent link="base_link" />
        <child link="livox_frame" />
        <origin xyz="0 0 1.44" rpy="0 0 0" />
    </joint>

    <link name="imu_link"/>
    <joint name="base_to_imu" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0.37 0 0" rpy="0 0 0" />
    </joint>

    <xacro:tof_sensor name="tof_side_right" parent="base_link" 
                      xyz="0.34 -0.215 0.30" rpy="0 0 -1.57" index="1" />
    <!-- index 0: side Left -->
    <xacro:tof_sensor name="tof_side_left" parent="base_link" 
                      xyz="0.34 0.215 0.30" rpy="0 0 1.57" index="1" />


    <xacro:kangaroo_x2_driver name="kangaroo_ros2_control" prefix="" use_sim_time="false"/>

</robot>
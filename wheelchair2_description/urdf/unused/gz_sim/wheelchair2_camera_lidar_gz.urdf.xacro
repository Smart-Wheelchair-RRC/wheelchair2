<?xml version="1.0"?>
<robot name="wheelchair2"
	xmlns:xacro="http://www.ros.org/wiki/xacro">

	<gazebo>
		<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
			<!-- Remove <ros> tag. -->

			<!-- wheels -->
			<left_joint>chassis_to_left_wheel</left_joint>
			<right_joint>chassis_to_right_wheel</right_joint>

			<!-- kinematics -->
			<wheel_separation>0.48</wheel_separation>
			<wheel_radius>0.155</wheel_radius>
			<!-- computed from <wheel_diameter> in the original plugin -->

			<!-- limits -->
			<max_linear_acceleration>0.155</max_linear_acceleration>
			<topic>cmd_vel</topic>

			<odom_topic>odom</odom_topic> <!-- from <odometry_topic> -->
			<frame_id>odom</frame_id> <!-- from <odometry_frame> -->
			<child_frame_id>base_link</child_frame_id> <!-- from <robot_base_frame> -->
			<odom_publisher_frequency>30</odom_publisher_frequency> <!-- from <update_rate>-->
			<tf_topic>/tf</tf_topic> <!-- Short topic name for tf output -->

		</plugin>
	</gazebo>
	<gazebo reference="chassis_to_left_wheel">
		<mu1 value="10000.0" />
		<mu2 value="10000.0" />
		<fdir1 value="0 0 1" />
		<kp value="300" />
		<!--500000-->
		<kd value="10" />
		<!--10-->
		<ki value="200" />
		<maxVel value="2.0" />
		<minDepth value="0.0001" />
	</gazebo>
	<gazebo reference="chassis_to_right_wheel">
		<mu1 value="10000.0" />
		<mu2 value="10000.0" />
		<fdir1 value="0 0 1" />
		<kp value="300" />
		<kd value="10" />
		<ki value="200" />
		<maxVel value="2.0" />
		<minDepth value="0.0001" />
	</gazebo>

	<gazebo reference="chassis">
		<material>Gazebo/FlatBlack</material>
	</gazebo>


	<gazebo reference="caster1">
		<material>Gazebo/White</material>
		<mu1>0.0</mu1>
		<mu2>0.0</mu2>
		<fdir1>0 0 0</fdir1>
		<kp>1000000.0</kp>
		<kd>100.0</kd>
		<minDepth>0.001</minDepth>
		<maxVel>1.0</maxVel>
	</gazebo>

	<gazebo reference="caster2">
		<material>Gazebo/White</material>
		<mu1>0.0</mu1>
		<mu2>0.0</mu2>
		<kp>1000000.0</kp>
		<kd>100.0</kd>
		<minDepth>0.001</minDepth>
		<maxVel>1.0</maxVel>
	</gazebo>

	<gazebo reference="rod1">
		<material>Gazebo/Grey</material>
	</gazebo>

	<gazebo reference="rod2">
		<material>Gazebo/Grey</material>
	</gazebo>

	<gazebo reference="camera_base_rod">
		<material>Gazebo/Grey</material>
	</gazebo>

	<gazebo reference="lidar_base_rod">
		<material>Gazebo/Grey</material>
	</gazebo>
	<gazebo reference="rplidar">
		<material>Gazebo/DarkGrey</material>

		<sensor name="laser" type="gpu_lidar">
			<pose> 0 0 0 0 0 0 </pose>
			<visualize>true</visualize>
			<update_rate>15</update_rate>
			<topic>scan</topic>
			<gz_frame_id>rplidar</gz_frame_id>
			<lidar>
				<scan>
					<horizontal>
						<samples>720</samples>
						<min_angle>-1.57</min_angle>
						<max_angle>1.57</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.1</min>
					<max>25</max>
				</range>
				<noise>
					<type>gaussian</type>
					<!-- Noise parameters based on published spec for Hokuyo laser
               achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
               stddev of 0.01m will put 99.7% of samples within 0.03m of the true
               reading. -->
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			</lidar>
		</sensor>
	</gazebo>


</robot>


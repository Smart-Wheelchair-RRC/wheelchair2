<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="kangaroo_x2_driver" params="name prefix">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>wheelchair2_kangaroo_x2_driver/Kangaroo</plugin>
        <param name="left_wheel_name">left_wheel_joint</param>
        <param name="right_wheel_name">right_wheel_joint</param>
        <param name="wheel_diameter">0.32</param>
        <param name="wheel_center_distance">0.55</param>
        <param name="encoder_lines_per_revolution">65536</param>
        <param name="hz">50</param>
        <param name="port">/dev/ttyACM0</param>
      </hardware>
      <joint name="${prefix}left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
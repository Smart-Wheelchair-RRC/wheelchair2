<?xml version="1.0" encoding="utf-8"?>

<sdf version='1.6'>
  <world name='default'>

    <plugin name='set_entity_state_plugin' filename='libset_entity_state.so'>
      <robot_name>softbot</robot_name>
    </plugin>
    
    <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
      <ros>
        <argument>model_states:=model_states_demo</argument>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <!-- override the default position of the camera !-->
    <gui>
      <camera name='gzclient_camera'>
        <pose>-4.4965503 -0.4874 30.508684 0 20 0</pose>
      </camera>
    </gui>
    <physics type='ode'>
        <gravity>0 0 -9.81</gravity>
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1</real_time_factor>
        <ode>
          <solver>
            <type>quick</type>
            <!-- iters: solver iterations per step, 50–100 stabilizes multi-wheel contact. -->
            <iters>50</iters>
            <!-- sor: over-relaxation, 1.2–1.3 speeds convergence (1.0 = off). -->
            <sor>1.0</sor>
          </solver>
          <constraints>
            <!-- cfm: softness/compliance at joints/contacts, 1e-6..1e-5 tames jitter, 0 = rigid. -->
            <cfm>0.0</cfm>
            <!-- erp: error reduction (springiness). 0.1–0.3 typical, higher = snappier corrections. -->
            <erp>0.2</erp>
            <!-- contact_max_correcting_vel: Cap on separation speed. 30–100 lets penetrations resolve fast. -->
            <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
            <!-- contact_surface_layer: Allowed penetration skin. 1e-5 avoids visible sinking; 0 = none. -->
            <contact_surface_layer>0.0</contact_surface_layer>
          </constraints>
        </ode>
        <real_time_update_rate>1000</real_time_update_rate>
        <max_step_size>0.001</max_step_size>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    

    <!-- Ground -->
    <include>
        <uri>model://ground_plane</uri>
    </include> 

    <!-- Walls -->
    <model name='Walls'>
        <static>true</static>    
        <include>
            <uri>model://building_editor_models/simple_corridor</uri>
        </include>
        <pose frame=''>0 0 0 0 -0 0</pose>
	</model> 

    <!-- Lights -->
    <light name='LivingRoom_WallLight_1' type='point'>
      <pose frame=''>8 0 2.2 0 -0 0</pose>
      <diffuse>0.24 0.24 0.24 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.12</constant>
        <linear>0.00</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name='LivingRoom_WallLight_2' type='point'>
      <pose frame=''>18 0 2.2 0 -0 0</pose>
      <diffuse>0.24 0.24 0.24 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.12</constant>
        <linear>0.00</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
        <light name='LivingRoom_WallLight_0' type='point'>
      <pose frame=''>-2 0 2.2 0 -0 0</pose>
      <diffuse>0.24 0.24 0.24 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.15</constant>
        <linear>0.00</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
        <light name='LivingRoom_WallLight_3' type='point'>
      <pose frame=''>28 0 2.2 0 -0 0</pose>
      <diffuse>0.24 0.24 0.24 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.12</constant>
        <linear>0.00</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0 0 -1</direction>
    </light>


  </world>
</sdf>

<?xml version="1.0" encoding="utf-8"?>
<robot name="wheelchair" xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="wheel_chair_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_chair_link">
    <visual>
      <origin xyz="-0.2 0 0" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="package://wheelchair2_gazebo_classic/meshes/wheel_chair.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.15 0 0.45" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.5"/> 
      </geometry>
    </collision>
    <xacro:box_inertia m="25.0" w="0.7" h="1.0" d="0.8"/>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://wheelchair2_gazebo_classic/meshes/left_wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="2.0" r="0.15" h="0.05"/>
  </link>

  <joint name="left_wheel_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.00432 -0.25998 0.14563"/>
    <parent link="wheel_chair_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/> 
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://wheelchair2_gazebo_classic/meshes/right_wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="2.0" r="0.15" h="0.05"/>
  </link>

  <joint name="right_wheel_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.00431 0.28301 0.14557"/>
    <parent link="wheel_chair_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/> 
  </joint>

  <link name="casterwheel_holder_left_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><mesh filename="package://wheelchair2_gazebo_classic/meshes/casterwheel_holder_left.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <xacro:box_inertia m="1.0" w="0.05" h="0.05" d="0.05"/> 
  </link>

  <joint name="casterwheel_holder_left_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.3255 -0.2021 0.2312"/>
    <parent link="wheel_chair_link"/>
    <child link="casterwheel_holder_left_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="caster_wheel_left_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.03"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.03"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.5" r="0.085" h="0.03"/>
  </link>

  <joint name="caster_wheel_left_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 -0.155"/>
    <parent link="casterwheel_holder_left_link"/>
    <child link="caster_wheel_left_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="casterwheel_holder_right_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><mesh filename="package://wheelchair2_gazebo_classic/meshes/casterwheel_holder_left.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <xacro:box_inertia m="1.0" w="0.05" h="0.05" d="0.05"/>
  </link>

  <joint name="casterwheel_holder_right_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.3255 0.2221 0.2312"/>
    <parent link="wheel_chair_link"/>
    <child link="casterwheel_holder_right_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="caster_wheel_right_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.03"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.03"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.5" r="0.085" h="0.03"/>
  </link>

  <joint name="caster_wheel_right_link_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 -0.157"/>
    <parent link="casterwheel_holder_right_link"/>
    <child link="caster_wheel_right_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://wheelchair2_gazebo_classic/meshes/lidar.dae"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" w="0.05" h="0.05" d="0.05"/>
  </link>

  <joint name="lidar_link_joint" type="fixed">
    <origin rpy="3.14159 0 0" xyz="-0.20249 0.01960 1.52496"/>
    <parent link="wheel_chair_link"/>
    <child link="lidar_link"/>
  </joint>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_link_joint</left_joint>
      <right_joint>right_wheel_link_joint</right_joint>
      <wheel_separation>0.54</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>
      <max_wheel_torque>50</max_wheel_torque>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="wheelchair_3d_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize> <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.2617</min_angle> <max_angle>0.2617</max_angle>  </vertical>
        </scan>
        <range>
          <min>0.3</min> <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_3d_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/livox/lidar</remapping> 
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>

      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <joint_name>casterwheel_holder_left_link_joint</joint_name>
      <joint_name>caster_wheel_left_link_joint</joint_name>
      <joint_name>casterwheel_holder_right_link_joint</joint_name>
      <joint_name>caster_wheel_right_link_joint</joint_name>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="left_wheel_link"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  
  <gazebo reference="caster_wheel_left_link">
    <mu1>100.1</mu1>
    <mu2>100.1</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <!-- <minDepth>0.001</minDepth> -->
  </gazebo>

  <gazebo reference="caster_wheel_right_link">
    <mu1>100.1</mu1>
    <mu2>100.1</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <!-- <minDepth>0.001</minDepth> -->
  </gazebo>

</robot>
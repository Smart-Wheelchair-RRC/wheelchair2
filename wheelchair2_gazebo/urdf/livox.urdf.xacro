<?xml version="1.0"?>
<robot name="wheelchair2"
    xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo reference="livox_frame">
        <material>Gazebo/Black</material>

        <sensor name="Livox" type="custom">
            <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
                <range>
                    <min>0</min>
                    <max>10</max>
                </range>
                <update_rate>10</update_rate>
                <update_on_paused_sim>false</update_on_paused_sim>
                <topic>rgl_lidar</topic>
                <frame>livox_frame</frame>
                <pattern_preset>Livox Mid360</pattern_preset>
            </plugin>
        </sensor>

        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <topic>livox_imu</topic>
        </sensor>

    </gazebo>

</robot>

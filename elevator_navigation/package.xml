<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>elevator_navigation</name>
    <version>0.1.0</version>
    <description>Python-based multi-floor topological navigation and elevator state machine for ROS 2</description>
    <maintainer email="laksh.nanwani@research.iiit.ac.in">Wheelchair Team</maintainer>
    <license>MIT</license>

    <!-- Core ROS 2 & Middleware -->
    <depend>rclpy</depend>
    <depend>rcl_interfaces</depend>
    <depend>action_msgs</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>

    <!-- Sensor & Navigation Interfaces -->
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>nav2_msgs</depend>

    <!-- Vision & ArUco Processing -->
    <depend>cv_bridge</depend>
    <depend>python3-opencv</depend>

    <!-- Python Libraries -->
    <depend>python3-networkx</depend>
    <depend>python3-yaml</depend>

    <!-- Testing -->
    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
[submodule "dependencies/realsense-ros"]
	path = dependencies/realsense-ros
	url = https://github.com/rtarun1/realsense-ros.git
	branch = ros2-master
[submodule "dependencies/pointcloud_to_laserscan"]
	path = dependencies/pointcloud_to_laserscan
	url = https://github.com/rtarun1/pointcloud_to_laserscan.git
	branch = humble
[submodule "dependencies/livox_ros_driver2"]
	path = dependencies/livox_ros_driver2
	url = https://github.com/rtarun1/livox_ros_driver2.git
	branch = master
[submodule "dependencies/icp_localization_ros2"]
	path = dependencies/icp_localization_ros2
	url = https://github.com/baiyeweiguang/icp_localization_ros2.git
[submodule "dependencies/FAST_LIO"]
	path = dependencies/FAST_LIO
	url = https://github.com/rtarun1/FAST_LIO.git
	branch = ROS2
[submodule "dependencies/rplidar_ros"]
	path = dependencies/rplidar_ros
	url = https://github.com/Slamtec/rplidar_ros.git
[submodule "dependencies/laser_filters"]
	path = dependencies/laser_filters
	url = https://github.com/ros-perception/laser_filters.git

[submodule "dependencies/realsense-ros"]
	path = dependencies/realsense-ros
	url = https://github.com/rtarun1/realsense-ros.git
	branch = ros2-master
[submodule "dependencies/pointcloud_to_laserscan"]
	path = dependencies/pointcloud_to_laserscan
	url = https://github.com/rtarun1/pointcloud_to_laserscan.git
	branch = humble
[submodule "dependencies/livox_ros_driver2"]
	path = dependencies/livox_ros_driver2
	url = https://github.com/rtarun1/livox_ros_driver2.git
	branch = master
[submodule "dependencies/FAST_LIO"]
	path = dependencies/FAST_LIO
	url = https://github.com/Smart-Wheelchair-RRC/FAST_LIO
	branch = ROS2
[submodule "RRC-3DLocalization"]
	path = RRC-3DLocalization
	url = https://github.com/Smart-Wheelchair-RRC/RRC-3DLocalization
[submodule "dependencies/icp"]
	path = dependencies/icp_localization_ros2
	url = https://github.com/Smart-Wheelchair-RRC/icp_localization_ros2
[submodule "dependencies/direct_lidar_inertial_odometry"]
	path = dependencies/direct_lidar_inertial_odometry
	url = https://github.com/vectr-ucla/direct_lidar_inertial_odometry
	branch = feature/ros2
[submodule "dependencies/iris_lama_ros"]
	path = dependencies/iris_lama_ros
	url = https://github.com/Smart-Wheelchair-RRC/iris_lama_ros.git

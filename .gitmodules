[submodule "dependencies/realsense-ros"]
	path = dependencies/realsense-ros
	url = https://github.com/Smart-Wheelchair-RRC/realsense-ros.git
	branch = ros2-master
[submodule "dependencies/pointcloud_to_laserscan"]
	path = dependencies/pointcloud_to_laserscan
	url = https://github.com/Smart-Wheelchair-RRC/pointcloud_to_laserscan.git
	branch = humble
[submodule "dependencies/livox_ros_driver2"]
	path = dependencies/livox_ros_driver2
	url = https://github.com/Smart-Wheelchair-RRC/livox_ros_driver2.git
	branch = deployment
[submodule "dependencies/FAST_LIO"]
	path = dependencies/FAST_LIO
	url = https://github.com/Smart-Wheelchair-RRC/FAST_LIO
	branch = ROS2
[submodule "dependencies/icp"]
	path = dependencies/icp_localization_ros2
	url = https://github.com/Smart-Wheelchair-RRC/icp_localization_ros2
	branch = development
[submodule "dependencies/direct_lidar_inertial_odometry"]
	path = dependencies/direct_lidar_inertial_odometry
	url = https://github.com/Smart-Wheelchair-RRC/direct_lidar_inertial_odometry
	branch = development
[submodule "dependencies/3DLocalization"]
	path = dependencies/3DLocalization
	url = https://github.com/Smart-Wheelchair-RRC/RRC-3DLocalization.git
	branch = deployment
[submodule "dependencies/rplidar_ros"]
	path = dependencies/rplidar_ros
	url = https://github.com/Slamtec/rplidar_ros.git
[submodule "dependencies/robot_security"]
	path = dependencies/robot_security
	url = https://github.com/ShivXShakti/robot_security.git
	branch = deployment
[submodule "dependencies/silica_ros"]
	path = dependencies/silica_ros
	url = https://github.com/GlassDetection/silica_ros
[submodule "dependencies/wheelchair_intelligence_ros2"]
	path = dependencies/wheelchair_intelligence_ros2
	url = https://github.com/ShivXShakti/wheelchair_intelligence_ros2.git
	branch = deployment

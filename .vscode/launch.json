{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "ROS: Launch",
			"type": "ros",
			"request": "launch",
			"target": "/home/radtop/ros2/wheelchair_ws/src/wheelchair2_simulation/launch/wheelchair2_ignition.launch.py"
		},
		{
			"name": "ROS: Attach",
			"type": "ros",
			"request": "attach"
		},
		{
			"name": "Python: Current File",
			"type": "python",
			"request": "launch",
			"program": "${file}",
			"args": ["--arg1", "value"],
			"console": "integratedTerminal",
			"justMyCode": true
		},
	]
}
